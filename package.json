{
  "name": "licencjat",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.mjs\" vite.config.ts tsconfig.json tsconfig.node.json package.json index.html",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"tests/**/*.mjs\" vite.config.ts tsconfig.json tsconfig.node.json package.json index.html"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "firebase": "^12.17.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.18.2",
    "tailwindcss": "^4.3.3",
    "webgl-fluid-enhanced": "^0.8.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "18.3",
    "@types/react-dom": "18.3",
    "@vitejs/plugin-react": "^6.0.5",
    "daisyui": "^5.7.16",
    "prettier": "3.10.1",
    "typescript": "^7.0.2",
    "vite": "8.2.1"
  },
  "prettier": {
    "endOfLine": "auto",
    "tabWidth": 2,
    "useTabs": false,
    "singleQuote": false,
    "semi": true
  }
}
